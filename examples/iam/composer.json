{
    "name": "example/iam",
    "type": "project",
    "require": {
        "php": "^8.4",
        "example/foundation": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "mk-josias/laravel-microservices-http-rpc": "*",
        "mk-josias/laravel-microservices": "*",
        "mk-josias/laravel-microservices-redis-stream": "*"
    },
    "repositories": {
        "http-rpc": {
            "type": "path",
            "url": "../../packages/http-rpc",
            "options": {"versions": {"mk-josias/laravel-microservices-http-rpc": "0.1.0"}}
        },
        "redis-stream": {
            "type": "path",
            "url": "../../packages/redis-stream",
            "options": {"versions": {"mk-josias/laravel-microservices-redis-stream": "0.1.0"}}
        },
        "foundation": {
            "type": "path",
            "url": "../foundation",
            "options": {"versions": {"example/foundation": "1.0.0"}}
        },
        "microservices": {
            "type": "path",
            "url": "../../packages/core",
            "options": {"versions": {"mk-josias/laravel-microservices": "0.1.0"}}
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
