{
    "name": "mk-josias/laravel-microservices",
    "description": "Laravel apps as microservices: signed RPC through contracts, ordered events with an outbox, and read-only copies of another service's rows.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "microservices",
        "rpc",
        "events",
        "outbox",
        "redis-streams"
    ],
    "authors": [
        {
            "name": "Josias Mekontso",
            "email": "josiasmekontso.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "suggest": {
        "ext-redis": "Required by the redis events transport (predis/predis works too)"
    },
    "autoload": {
        "psr-4": {
            "Microservices\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Microservices\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Microservices\\Providers\\MicroservicesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
