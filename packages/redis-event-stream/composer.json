{
    "name": "mk-josias/redis-event-stream",
    "description": "Redis Streams driver for the events of mk-josias/laravel-microservices: one ordered stream, a consumer group per service, failed entries retried before later ones.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "microservices",
        "events",
        "redis-streams"
    ],
    "authors": [
        {
            "name": "Josias Mekontso",
            "email": "josiasmekontso.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "mk-josias/laravel-microservices": "self.version"
    },
    "suggest": {
        "ext-redis": "PhpRedis client (predis/predis works too)"
    },
    "autoload": {
        "psr-4": {
            "RedisEventStream\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RedisEventStream\\RedisEventStreamServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
