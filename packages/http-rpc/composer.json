{
    "name": "mk-josias/http-rpc",
    "description": "HTTP driver for the RPC of mk-josias/laravel-microservices: signed calls between services, one endpoint per service.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "microservices",
        "rpc",
        "http"
    ],
    "authors": [
        {
            "name": "Josias Mekontso",
            "email": "josiasmekontso.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "mk-josias/laravel-microservices": "self.version"
    },
    "autoload": {
        "psr-4": {
            "HttpRpc\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HttpRpc\\HttpRpcServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
